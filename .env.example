# 默认模型（也可在网页右上角 ⚙️ 设置中心里切换）
# 可选: openai | gemini | deepseek | moonshot | minimax | anthropic | qwen | glm | custom
MODEL_NAME=openai

# 各家 API Key（也可在网页设置中心填写，会覆盖此处的值）
OPENAI_API_KEY=
# Gemini 用 GOOGLE_API_KEY（或 GEMINI_API_KEY 均可）
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=

# 自定义 OpenAI 兼容端点（MODEL_NAME=custom 时用）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# 百度地图 AK（可选，户外训练规划的地点/路线查询；服务端类型，lbsyun.baidu.com 免费申请）
BAIDU_MAP_AK=

# 服务端口
PORT=3000

# 数据存储
DATABASE_PATH=recipe_manager.db
